# Dependencies
# Keep local dependency trees out of `az acr build` source packaging.
# The broad patterns are intentional because pnpm creates nested/symlinked
# node_modules paths that Azure CLI can try to walk on Windows.
node_modules
node_modules/**
**/node_modules
**/node_modules/**
.pnpm
.pnpm/**
**/.pnpm
**/.pnpm/**
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js build output
.next
out

# Local workspace/uploads/results/traces
workspace

# Environment/secrets
.env
.env.*
!.env.example
app/.env

# Git and editor files
.git
.gitignore
.vscode
.idea
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Docker files are still copied only if explicitly needed by build context
Dockerfile
.dockerignore

# Misc caches/logs
.eslintcache
*.log
coverage
